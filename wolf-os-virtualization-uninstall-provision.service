[Unit]
Description=Wolf-OS Virtualization Uninstall Provisioner
After=local-fs.target
# Only run if the uninstaller hasn't been created yet
ConditionPathExists=!/etc/systemd/system/wolf-os-virtualization-uninstall.service

[Service]
Type=oneshot
User=root
# Execute the uninstall provision script
ExecStart=/usr/libexec/wolf-os-virtualization-uninstall-provision.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
